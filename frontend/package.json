{
  "name": "assetflow-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'src/**/*.integration.test.tsx'",
    "test:integration": "vitest run src/pages/*.integration.test.tsx",
    "test:watch": "vitest",
    "e2e": "env -u NO_COLOR -u FORCE_COLOR playwright test",
    "e2e:headed": "env -u NO_COLOR -u FORCE_COLOR playwright test --headed",
    "e2e:ui": "env -u NO_COLOR -u FORCE_COLOR playwright test --ui",
    "e2e:install": "playwright install",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "typescript": "5.7.2",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "postcss": "8.5.25",
    "tailwindcss": "3.4.17",
    "vitest": "^4.1.10"
  }
}
